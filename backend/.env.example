APP_NAME=ArthaDrishti API
APP_ENV=development
DEBUG=true
API_V1_PREFIX=/api/v1
DATABASE_URL=postgresql+psycopg://arthadrishti_dev:arthadrishti_dev_password@localhost:5432/arthadrishti_dev
FRONTEND_ORIGIN=http://localhost:3000
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
DOCUMENT_STORAGE_PATH=storage/documents
MAX_UPLOAD_SIZE_MB=10
ALLOWED_DOCUMENT_MIME_TYPES=application/pdf
LLM_PROVIDER=mock
LLM_API_KEY=
LLM_MODEL=mock-financial-tool-caller
ASSISTANT_MAX_QUESTION_CHARS=500
ASSISTANT_MAX_TOOL_ROUNDS=3
EMBEDDING_PROVIDER=local
EMBEDDING_MODEL=arthadrishti-keyword-hashing-v1
EMBEDDING_DIMENSIONS=16
RAG_CHUNK_SIZE_CHARS=1200
RAG_CHUNK_OVERLAP_CHARS=200
RAG_RETRIEVAL_MIN_SCORE=0.15
